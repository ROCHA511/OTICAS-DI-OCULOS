# ============================================================================
# MODELO DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - ÓTICA INTELIGENTE 2.0
# Copie este arquivo para ".env" e preencha as credenciais.
# ============================================================================

# URL de Conexão com o Banco de Dados (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:sua_senha@host_do_banco:5432/otica_inteligente

# Configuração de Segurança e Autenticação (JWT Supabase)
SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_do_supabase
SUPABASE_JWT_SECRET=seu_jwt_secret_do_supabase

# Integrações com API de Mensagens do WhatsApp (Gateway)
WHATSAPP_API_URL=https://api.z-api.io/instances/sua_instancia/token
WHATSAPP_CLIENT_TOKEN=seu_token_de_cliente_whatsapp

# Configurações de API de OCR / Inteligência Artificial (Opcional)
OCR_API_KEY=sua_chave_do_servico_de_ocr
OPENAI_API_KEY=sua_chave_da_openai_para_assistente_ia
