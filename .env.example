# ============================================================================
# .env.example — ÓTICA INTELIGENTE 2.0
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais!
# ============================================================================

# --- SUPABASE (obrigatório) ---
# Acesse: https://supabase.com/dashboard/project/SEU_PROJECT_ID/settings/api
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# --- BANCO DE DADOS (conexão direta PostgreSQL) ---
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJECT_ID.supabase.co:5432/postgres

# --- GEMINI AI ---
GEMINI_API_KEY=sua_gemini_api_key_aqui

# --- MERCADO PAGO ---
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_mercadopago

# --- META WHATSAPP ---
META_WEBHOOK_VERIFY_TOKEN=seu_token_verificacao_webhook

# --- APP ---
APP_URL=https://seu-dominio.vercel.app
NODE_ENV=production
PORT=3000
